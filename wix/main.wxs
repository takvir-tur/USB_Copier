<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX Toolset configuration for `cargo wix` (.msi installer generation on Windows).
  Run `cargo install cargo-wix` and `cargo wix --nocapture` on Windows.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='USBBackup'
        UpgradeCode='8B4A1B90-7C54-4B9E-9A1D-2F6E4A10D892'
        Manufacturer='USBBackup Contributors'
        Language='1033'
        Codepage='1252'
        Version='0.1.0'>

        <Package Id='*'
            Keywords='Installer'
            Description='Automatic USB Flash Drive Backup and Safe Eject Utility'
            Manufacturer='USBBackup Contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='USBBackup Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='USBBackup'>
                    <Component Id=' BinaryComponent' Guid='6C2F3E40-2D19-4F08-A123-7B8D9E0F1A2B'>
                        <File
                            Id='exe0'
                            Name='usb-tray-sync.exe'
                            DiskId='1'
                            Source='target\release\usb-tray-sync.exe'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='USBBackup Application'
            Description='Installs the USBBackup background system tray utility.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='BinaryComponent'/>
        </Feature>
    </Product>
</Wix>
